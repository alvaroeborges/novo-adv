# =============================================================================
#  Jonathan & Associados — Agendamento de reuniões
#  Copie este arquivo para ".env" e preencha os valores reais.
#  O arquivo .env NUNCA deve ir para o Git (já está no .gitignore).
# =============================================================================

# --- Servidor -----------------------------------------------------------------
PORT=3000
# Se "false", o Express NÃO serve o site estático (use quando o front está no
# GitHub Pages e o backend roda separado). Em "true", serve index.html/css/js
# a partir da raiz do projeto — útil para testar tudo junto localmente.
SERVE_STATIC=true

# Domínios autorizados a chamar a API (separados por vírgula). Em produção,
# coloque a URL do site publicado. Vazio = libera qualquer origem (só dev).
# Ex.: https://jonathanassociados.adv.br,https://usuario.github.io
CORS_ORIGINS=

# --- Google OAuth 2.0 -------------------------------------------------------
# Criados no Google Cloud Console › APIs e Serviços › Credenciais › ID do
# cliente OAuth 2.0 (tipo "Aplicativo da Web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URI de redirecionamento autorizado. Precisa ser EXATAMENTE igual ao
# cadastrado no Console. Para gerar o refresh token localmente use:
#   http://localhost:3000/oauth2callback
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Gerado uma única vez com "npm run token" (autorize logado como a conta
# rodriguesadvocacia.adv01@gmail.com). É o que permite o backend agir pela conta.
GOOGLE_REFRESH_TOKEN=

# Agenda consultada e onde os eventos são criados. Use o e-mail da conta
# principal ("primary" também funciona se o refresh token for dessa conta).
GOOGLE_CALENDAR_ID=rodriguesadvocacia.adv01@gmail.com

# --- E-mail (OPCIONAL) -------------------------------------------------------
# O evento é criado com sendUpdates=all, então o próprio Google Agenda já
# envia convite real (com link do Meet) para o cliente e para o advogado.
# Preencha o bloco abaixo SOMENTE se quiser também os e-mails com o texto
# personalizado das seções 15 e 16 do briefing. Sem isso, o sistema funciona.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente exibido (padrão: SMTP_USER)
MAIL_FROM=Jonathan & Associados <contato@jonathanassociados.adv.br>
# Para onde vai a notificação de novo agendamento (padrão: GOOGLE_CALENDAR_ID)
LAWYER_NOTIFY_EMAIL=rodriguesadvocacia.adv01@gmail.com
